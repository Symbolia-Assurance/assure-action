{
  "$id": "urn:assure:postgresql-declaration:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "dependentRequired": {
    "protected_tables": [
      "declared_predicate",
      "access_paths_complete"
    ]
  },
  "description": "A declaration is a file in your repo at raw/declaration.json. Validation checks its shape. It names assumptions requiring operator confirmation and leaves verdicts to the checker. Existing legacy runtime declarations remain supported; add schema and id to validate against this public version. The declared predicate is matched by normalized SQL-text equality; tenant semantics are an operator assumption.",
  "execution_authorized": false,
  "hardware_authorized": false,
  "industrial_release_authorized": false,
  "physical_validation": false,
  "properties": {
    "access_paths_complete": {
      "type": "boolean"
    },
    "administrators": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "allow_publisher_bypassrls": {
      "type": "boolean"
    },
    "allow_publisher_superuser": {
      "type": "boolean"
    },
    "applications": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "authority_complete": {
      "type": "boolean"
    },
    "ca_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "ca": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "channel": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "server": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "channel",
          "ca",
          "server"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "caller": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "certificate_roles": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "collection_role": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "database_owner": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "declared_predicate": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "declared_revokes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cascade": {
            "type": "boolean"
          },
          "grant_id": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "grant_option_only": {
            "type": "boolean"
          },
          "object": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "object",
          "grant_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "default_acl_expectations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "creator": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "expected_acl": {
            "items": {
              "items": false,
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
                  "type": "string"
                },
                {
                  "enum": [
                    "SELECT",
                    "INSERT",
                    "UPDATE",
                    "DELETE"
                  ],
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "type": "array",
            "uniqueItems": true
          },
          "kind": {
            "const": "table"
          },
          "schema": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "creator",
          "schema",
          "kind",
          "expected_acl"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "disjoint_duties": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "left": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "object": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
