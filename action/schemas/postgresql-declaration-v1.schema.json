          },
          "database": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "method": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "rule_id": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "transport": {
            "enum": [
              "local",
              "plain",
              "tls",
              "gss"
            ],
            "type": "string"
          },
          "user": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "transport",
          "database",
          "user",
          "address",
          "method",
          "rule_id"
