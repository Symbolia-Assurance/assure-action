            "type": "array",
            "uniqueItems": true
          },
          "right": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "left",
          "right",
          "object",
          "privileges"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "exclusive_reader": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "execution_authorized": {
      "const": false
    },
    "forbidden_methods": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "hardware_authorized": {
      "const": false
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "type": "string"
    },
    "industrial_release_authorized": {
      "const": false
    },
    "intended_flows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "minLength": 1,
            "pattern": "\\S",
