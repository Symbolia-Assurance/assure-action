      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "key_file_mode": {
      "pattern": "^0?[0-7]{3}$",
      "type": "string"
    },
    "key_owner": {
      "enum": [
        "postgres",
        "root",
        "other"
      ],
      "type": "string"
    },
    "loaded_identity": {
      "enum": [
        "same",
        "different",
        "unknown"
      ],
      "type": "string"
    },
    "maintenance_window": {
      "type": "boolean"
    },
    "major": {
      "description": "Draft 2020-12 permits integer-valued numbers such as 17.0. The frozen derive step additionally requires integer JSON encoding (17), and the local validator reports that runtime compatibility rule.",
      "maximum": 18,
      "minimum": 14,
      "type": "integer",
      "x-runtime-integer-encoding": true
    },
    "no_loss_required": {
      "type": "boolean"
    },
    "owner_only_login": {
      "type": "boolean"
    },
    "permitted": {
      "additionalProperties": {
        "items": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "physical_validation": {
      "const": false
    },
    "privilege_queries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "privilege": {
            "enum": [
              "SELECT",
              "INSERT",
              "UPDATE",
              "DELETE"
            ],
            "type": "string"
          },
          "role": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "role",
          "object",
          "privilege"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "protected_tables": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "release_allowed": {
