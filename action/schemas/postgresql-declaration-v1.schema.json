      "type": "boolean"
    },
    "standby_addresses": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "standbys": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "name": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "primary_slot_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "standby_mode": {
            "type": "boolean"
          }
        },
        "required": [
