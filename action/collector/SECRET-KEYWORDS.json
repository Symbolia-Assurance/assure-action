  "withheld_value_marker": "<withheld: structured value>",
  "withheld_option_marker": "<withheld option>",
  "safe_value_charset": "^[A-Za-z0-9 ._:/,+-]*$",
  "safe_literals": {
    "listen_addresses": "\\*",
    "search_path": "\"\\$user\""
  },
  "structure_words": [
    "password",
    "secret",
    "token",
    "passphrase"
  ],
  "safe_url_grammar": "^(?:https?://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._/-]*)?|ldaps?://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9=,._/-]*)?)$",
  "uri_userinfo_rule": "^[A-Za-z][A-Za-z0-9+.-]*://[^/\\s]*@",
